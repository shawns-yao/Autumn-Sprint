# Replace with a real hostname before deployment; no scheme, port or path.
DOMAIN=jobs.example.com

# Generate a bcrypt hash with:
# docker run --rm -it --entrypoint caddy caddy:2-alpine hash-password
# Put the hash in single quotes to preserve dollar signs.
BASIC_AUTH_USER=admin
BASIC_AUTH_PASSWORD_HASH=''

# Backend only. Never use a VITE_ prefix for this secret.
# A nonempty value takes precedence over a key saved in the settings page.
# Set the provider URL and model in the settings page.
AI_API_KEY=''
